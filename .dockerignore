# Keep the build context small and never bake data or secrets into an image
.git
.github
.gitignore
docs
*.md
Dockerfile
.dockerignore
docker-compose.yml

# Tests are not needed at runtime
backend/tests

# Local data and caches (the database and uploads belong in the /data volume)
backend/data
**/__pycache__
**/*.pyc
**/*.db
**/*.db-wal
**/*.db-shm

# Only used when running without the backend
frontend/serve.py
